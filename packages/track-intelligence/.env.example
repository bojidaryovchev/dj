# Copy to .env. Every setting is also a plain environment variable, and every
# one of them is prefixed DJTI_. Values shown are the defaults.

# --- engines ------------------------------------------------------------
# auto | essentia | chroma      ("chroma" is the librosa CQT backend)
DJTI_KEY_ENGINE=auto
DJTI_TEMPO_ENGINE=auto

# Key profile used to score chroma against the 24 candidate keys.
# edma is trained on electronic dance music and is the right default here;
# temperley / krumhansl suit acoustic material better.
DJTI_KEY_PROFILE=edma

# Harmonic/percussive separation before chroma (chroma backend only).
# Measured ~30x slower with no change in detected key, so it is off; flip it
# on to evaluate against a labelled library.
DJTI_KEY_HARMONIC_SEPARATION=false

# --- decoding -----------------------------------------------------------
DJTI_SAMPLE_RATE=44100
# Cap analysis at N seconds of audio (0 = whole file). Useful for bulk runs.
DJTI_MAX_ANALYSIS_SECONDS=0
DJTI_FFMPEG_PATH=ffmpeg
DJTI_FFPROBE_PATH=ffprobe

# --- tonal segmentation -------------------------------------------------
DJTI_SEGMENTS_ENABLED=true
DJTI_SEGMENT_WINDOW_SECONDS=30.0
DJTI_SEGMENT_HOP_SECONDS=15.0
DJTI_SEGMENT_MIN_CONFIDENCE=0.3

# --- reliability thresholds ---------------------------------------------
# Below these, the result is reported but flagged reliable=false.
DJTI_KEY_MIN_RELIABILITY=0.35
# How far the chroma must be from flat before any key is claimed at all.
# Guards against reporting a key for noise or percussion-only material.
DJTI_KEY_MIN_TONAL_SALIENCE=0.01
DJTI_TEMPO_MIN_RELIABILITY=0.35
# RMS below this counts as silence and no tonal/rhythmic claim is made.
DJTI_SILENCE_RMS_DBFS=-60.0
# Shorter than this and there is not enough signal to analyse.
DJTI_MIN_DURATION_SECONDS=1.0

# --- tempo interpretation -----------------------------------------------
DJTI_DJ_BPM_MIN=70.0
DJTI_DJ_BPM_MAX=180.0
# Coefficient of variation of inter-beat intervals above which a track is
# reported as tempo-unstable (live edits, rubato, tempo ramps).
DJTI_TEMPO_STABILITY_MAX_CV=0.04

# --- loudness -----------------------------------------------------------
DJTI_LOUDNESS_ENABLED=true

# --- api ----------------------------------------------------------------
DJTI_MAX_UPLOAD_BYTES=268435456
DJTI_HOST=0.0.0.0
DJTI_PORT=8000

# --- logging ------------------------------------------------------------
# json | console
DJTI_LOG_FORMAT=console
DJTI_LOG_LEVEL=INFO

# --- analysis profile ---------------------------------------------------
# basic | full | warp
#   basic  tempo, key, loudness only
#   full   + downbeats, meter, tempo curve, grid, tonal segments, structure
#   warp   + tempo map, warp map, warp recommendation
DJTI_PROFILE=full

# --- rhythm -------------------------------------------------------------
DJTI_DOWNBEATS_ENABLED=true
# Correct the beat grid's systematic phase error. Beat trackers report beats
# late (+29.8 ms measured for librosa) because the onset envelope peaks after
# the transient. Off means the grid stays uniformly late.
DJTI_BEAT_OFFSET_REFINEMENT=true
DJTI_TEMPO_CURVE_WINDOW_BEATS=64
DJTI_TEMPO_CURVE_HOP_BEATS=32
# Meter to assume when detection cannot establish one. Empty = assume nothing.
DJTI_FALLBACK_BEATS_PER_BAR=

# --- structure ----------------------------------------------------------
DJTI_STRUCTURE_ENABLED=true
DJTI_PHRASE_BARS=8
DJTI_STRUCTURE_MIN_SPACING_BARS=4

# --- warp ---------------------------------------------------------------
# Insert a marker once linear interpolation would put a beat further than
# this from where it belongs.
DJTI_WARP_MAX_GRID_ERROR_MS=10.0
DJTI_WARP_MAX_MARKER_DISTANCE_BARS=32
DJTI_WARP_MIN_MARKER_DISTANCE_BEATS=16
# Below this systematic error, warping is refused: it would cost transient
# quality for no audible gain.
DJTI_WARP_TOLERANCE_MS=15.0
DJTI_WARP_MIN_GRID_CONFIDENCE=0.5
# A correction outside this range means the grid or the metrical level is
# wrong, not that the track really moves that much.
DJTI_WARP_MIN_SAFE_STRETCH_RATIO=0.9
DJTI_WARP_MAX_SAFE_STRETCH_RATIO=1.1
# Equal-power crossfade at segment joins in the renderer.
DJTI_WARP_CROSSFADE_MS=8.0
DJTI_WARP_VERIFICATION_THRESHOLD_MS=15.0
